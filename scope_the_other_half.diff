+    check: Optional[Callable[["CandidateStructure"], bool]] = None
     applied: bool = False
     result: Optional[bool] = None  # True if falsifier triggered
     evidence: Optional[str] = None
 
+    def is_executable(self) -> bool:
+        return self.check is not None
